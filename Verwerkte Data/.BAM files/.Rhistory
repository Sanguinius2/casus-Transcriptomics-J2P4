#================================================
FiltF <- readRDS("C:/Users/sande/OneDrive - NHL Stenden/school/jaar 2/Periode 4/casus metagenomics/Dataset_Crohn/filt_F.rds")
#kijk of de reads goed zijn
errF <- learnErrors(filtF, multithread=TRUE)
#================================================
#WERKCOLLEGE 2
#================================================
filtF <- readRDS("C:/Users/sande/OneDrive - NHL Stenden/school/jaar 2/Periode 4/casus metagenomics/Dataset_Crohn/filt_F.rds")
filtR <- readRDS("C:/Users/sande/OneDrive - NHL Stenden/school/jaar 2/Periode 4/casus metagenomics/Dataset_Crohn/filt_R.rds")
#kijk of de reads goed zijn
errF <- learnErrors(filtF, multithread=TRUE)
errR <- learnErrors(filtR, multithread=TRUE)
#run dada to identify bacteria
dadaF <- dada(filtF, err=errF, multithread=TRUE)
dadaF
dadaR <- dada(filtR, err=errR, multithread=TRUE)
dadaR
#reads samenvoegen
merged <- mergePairs(dadaF, filtF, dadaR, filtR, verbose=TRUE)
head(merged[[1]])
#sequentietabel
seqtab <- makeSequenceTable(merged)
table(nchar(getSequences(seqtab)))
#Chimera deletion
seqtab.nochim <- removeBimeraDenovo(seqtab, method="consensus", multithread=TRUE, verbose=TRUE)
sum(seqtab.nochim)/sum(seqtab)
# Dit is best ingewikkeld. Check vooral of je de tabel kan interpreteren die we hier maken.
# We definieren eerst een functie
getN <- function(x) sum(getUniques(x))
# Nu maken we de tabel 'track'. Daarvoor hebben we ook 'out' nodig die we tijdens het vorige werkcollege hebben gemaakt
track <- cbind(out, sapply(dadaF, getN), sapply(dadaR, getN), sapply(merged, getN), rowSums(seqtab.nochim))
# Hier voegen we kolomnamen aan toe om elke stap te kunnen onderscheiden
colnames(track) <- c("input", "filtered", "denoisedF", "denoisedR", "merged", "nonchim")
rownames(track) <- sample_names
head(track)
#WELEKWAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
#taxonomie toewijzen
taxa <- assignTaxonomy(seqtab.nochim, "C:/Users/sande/OneDrive - NHL Stenden/school/jaar 2/Periode 4/casus metagenomics/silva_nr99_v138.1_16S.fa", multithread=TRUE)
taxa.print <- taxa
rownames(taxa.print) <- NULL
taxa.print[1:20,]
# Je splitst op basis van - en pakt voor de groep het eerste stukje
replica <- sapply(strsplit(sample_names, "-"), `[`, 1)
# Voor de replica's doe je hetzelfde, maar pak je het tweede stukje (achter de -)
group <- sapply(strsplit(sample_names, "-"), `[`, 2)
# Nu maak je van deze informatie een dataframe
samdf <- data.frame(Group = group, Replica = replica)
# We willen ook nog de volledige samplenamen als rijnamen toegevoegd hebben
rownames(samdf) <- sample_names
# Check nog even wat je gemaakt hebt
samdf
#maak phylosec object
ps <- phyloseq(otu_table(seqtab.nochim, taxa_are_rows=FALSE),
sample_data(samdf),
tax_table(taxa))
saveRDS(ps, "C:/Users/sande/OneDrive - NHL Stenden/school/jaar 2/Periode 4/casus metagenomics/Dataset_Crohn/PS_object_Casus.rds")
